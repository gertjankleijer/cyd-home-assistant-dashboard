# Copy this file to secrets.yaml and replace every example value.
# NEVER commit secrets.yaml to GitHub.

# ESP / Wi-Fi
wifi_ssid: "YOUR_HOME_WIFI"
wifi_password: "YOUR_HOME_WIFI_PASSWORD"
guest_wifi_ssid: "YOUR_GUEST_WIFI"
guest_wifi_password: "YOUR_GUEST_WIFI_PASSWORD"

# Optional ESPHome API encryption.
# In ESPHome Device Builder you can use “Enable encryption” and store the generated key here.
api_encryption_key: "REPLACE_WITH_A_VALID_ESPHOME_API_KEY"

# Lights
light_living_room: "light.living_room"
light_kitchen: "light.kitchen"
light_office: "light.rgb_light"
light_dressoir: "light.light_4"

# Radio helper/button entities.
# These buttons should start the named station on your chosen media player.
music_538: "button.play_radio_538"
music_qmusic: "button.play_qmusic"
music_veronica: "button.play_veronica"
music_bingo_fm: "button.play_bingo_fm"
music_sterren_nl: "button.play_sterren_nl"

# Weather
weather_entity: "weather.home"
weather_temperature_entity: "sensor.outdoor_temperature"
weather_apparent_temperature: "sensor.feels_like_temperature"
weather_wind_entity: "sensor.wind_speed"
weather_pressure_entity: "sensor.air_pressure"
weather_wind_bearing_entity: "sensor.wind_bearing"

# Media / Home
media_player_entity: "media_player.your_media_player"
front_door_lock_entity: "lock.front_door"
living_room_climate_entity: "climate.living_room"
washing_machine_entity: "switch.washing_machine"
washing_machine_program_entity: "sensor.washing_machine_program"
washing_machine_temperature_entity: "sensor.washing_machine_temperature"
washing_machine_remaining_time_entity: "sensor.washing_machine_remaining_time"
